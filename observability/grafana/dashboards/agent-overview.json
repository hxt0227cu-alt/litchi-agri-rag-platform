{
  "title": "Litchi Agent Overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Agent runs per minute",
      "targets": [{"expr": "sum(rate(agent_runs_total[5m]))", "legendFormat": "runs/s"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Agent duration P95",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(agent_run_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Degraded rate",
      "targets": [{"expr": "sum(rate(agent_runs_total{degraded=\"true\"}[15m])) / sum(rate(agent_runs_total[15m]))", "legendFormat": "degraded"}],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Tool calls",
      "targets": [{"expr": "sum by (tool, status) (rate(agent_tool_calls_total[5m]))", "legendFormat": "{{tool}} {{status}}"}],
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8}
    }
  ]
}
